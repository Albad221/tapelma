<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{personalInfo.fullName}} - CV</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Georgia', 'Times New Roman', serif;
            color: #333;
            line-height: 1.6;
            background: #ffffff;
            padding: 40px 60px;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #2c3e50;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 10px;
            color: #2c3e50;
            letter-spacing: 1px;
        }

        .contact-info {
            font-size: 14px;
            color: #555;
            margin-top: 15px;
        }

        .contact-info span {
            margin: 0 15px;
        }

        .contact-info span:first-child {
            margin-left: 0;
        }

        .section {
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 22px;
            font-weight: 700;
            color: #2c3e50;
            border-bottom: 2px solid #34495e;
            padding-bottom: 8px;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .summary {
            font-size: 15px;
            color: #555;
            line-height: 1.8;
            text-align: justify;
            margin-bottom: 25px;
            font-style: italic;
        }

        .experience-item, .education-item {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }

        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 8px;
        }

        .item-title {
            font-size: 17px;
            font-weight: 700;
            color: #2c3e50;
        }

        .item-date {
            font-size: 13px;
            color: #7f8c8d;
            font-style: italic;
        }

        .item-subtitle {
            font-size: 15px;
            color: #34495e;
            margin-bottom: 5px;
            font-weight: 500;
        }

        .item-meta {
            font-size: 13px;
            color: #7f8c8d;
            margin-bottom: 10px;
        }

        .item-description {
            font-size: 14px;
            color: #555;
            line-height: 1.7;
            text-align: justify;
            white-space: pre-line;
        }

        .skills-section {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 15px;
        }

        .skill-category {
            background: #ecf0f1;
            padding: 15px;
            border-radius: 4px;
        }

        .skill-category-title {
            font-size: 14px;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 10px;
            text-transform: uppercase;
        }

        .skill-item {
            font-size: 13px;
            color: #555;
            margin: 5px 0;
        }

        .languages-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
        }

        .language-item {
            font-size: 14px;
            color: #555;
            padding: 10px;
            background: #f8f9fa;
            border-left: 3px solid #34495e;
        }

        .language-item strong {
            color: #2c3e50;
            font-weight: 600;
        }

        .certifications-list {
            list-style: none;
        }

        .cert-item {
            margin: 15px 0;
            padding-left: 20px;
            position: relative;
        }

        .cert-item::before {
            content: "→";
            position: absolute;
            left: 0;
            color: #34495e;
            font-weight: bold;
        }

        .cert-name {
            font-size: 15px;
            font-weight: 600;
            color: #2c3e50;
        }

        .cert-org {
            font-size: 13px;
            color: #555;
            margin-top: 2px;
        }

        .cert-date {
            font-size: 12px;
            color: #7f8c8d;
            font-style: italic;
            margin-top: 2px;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <!-- Profile Picture -->
        {{#if hasCVPicture}}
        <div style="text-align: center; margin-bottom: 20px;">
            <img src="{{cvPictureUrl}}" alt="Profile Picture" style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 3px solid #2c3e50; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);">
        </div>
        {{/if}}

        <h1>{{personalInfo.fullName}}</h1>
        <div class="contact-info">
            {{#if personalInfo.email}}<span>{{personalInfo.email}}</span>{{/if}}
            {{#if personalInfo.phone}}<span>•</span><span>{{personalInfo.phone}}</span>{{/if}}
            {{#if personalInfo.location}}<span>•</span><span>{{personalInfo.location}}</span>{{/if}}
            {{#if personalInfo.linkedIn}}<span>•</span><span>{{personalInfo.linkedIn}}</span>{{/if}}
        </div>
    </div>

    <!-- Summary -->
    {{#if personalInfo.summary}}
    <div class="section">
        <div class="summary">{{personalInfo.summary}}</div>
    </div>
    {{/if}}

    {{#if hasProfessionalSummary}}
    <div class="section">
        <h2 class="section-title">Résumé Professionnel</h2>
        <div class="item-description">
            <p>{{professionalSummary}}</p>
        </div>
    </div>
    {{/if}}

    <!-- Experience -->
    {{#if hasWorkExperience}}
    <div class="section">
        <h2 class="section-title">Expérience Professionnelle</h2>
        {{#each workExperiences}}
        <div class="experience-item">
            <div class="item-header">
                <div class="item-title">{{this.position}}</div>
                <div class="item-date">{{this.duration}}</div>
            </div>
            <div class="item-subtitle">{{this.companyName}}</div>
            {{#if this.location}}
            <div class="item-meta">{{this.location}}</div>
            {{/if}}
            {{#if this.description}}
            <div class="item-description">{{this.description}}</div>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}

    <!-- Education -->
    {{#if hasEducation}}
    <div class="section">
        <h2 class="section-title">Formation</h2>
        {{#each education}}
        <div class="education-item">
            <div class="item-header">
                <div class="item-title">{{this.degreeField}}</div>
                <div class="item-date">{{this.duration}}</div>
            </div>
            <div class="item-subtitle">{{this.institution}}</div>
            <div class="item-meta">
                {{#if this.location}}{{this.location}}{{/if}}
                {{#if this.gpa}}{{#if this.location}} • {{/if}}GPA: {{this.gpa}}{{/if}}
            </div>
            {{#if this.description}}
            <div class="item-description">{{this.description}}</div>
            {{/if}}
        </div>
        {{/each}}
    </div>
    {{/if}}

    <!-- Skills -->
    {{#if hasSkills}}
    <div class="section">
        <h2 class="section-title">Compétences</h2>
        <div class="skills-section">
            {{#each skills}}
            <div class="skill-item">• {{this.name}}</div>
            {{/each}}
        </div>
    </div>
    {{/if}}

    <!-- Languages -->
    {{#if hasLanguages}}
    <div class="section">
        <h2 class="section-title">Langues</h2>
        <div class="languages-grid">
            {{#each languages}}
            <div class="language-item">
                <strong>{{this.name}}:</strong> {{this.proficiency}}
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}

    <!-- Certifications -->
    {{#if hasCertifications}}
    <div class="section">
        <h2 class="section-title">Certifications</h2>
        <div class="certifications-list">
            {{#each certifications}}
            <div class="cert-item">
                <div class="cert-name">{{this.name}}</div>
                {{#if this.issuingOrganization}}
                <div class="cert-org">{{this.issuingOrganization}}</div>
                {{/if}}
                {{#if this.duration}}
                <div class="cert-date">{{this.duration}}</div>
                {{/if}}
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
</body>
</html>
