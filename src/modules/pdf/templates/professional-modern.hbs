<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{personalInfo.fullName}} - CV</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @page {
            size: A4;
            margin: 0;
        }

        body {
            font-family: 'Arial', 'Helvetica', sans-serif;
            color: #333;
            line-height: 1.6;
            background: #f5f5f5;
        }

        .big-container {
            display: flex;
            min-height: 100vh;
            background: white;
        }

        /* Left Container - Main Content */
        .left-container {
            width: 65%;
            padding: 50px 40px;
            background: white;
        }

        header {
            margin-bottom: 30px;
        }

        .name {
            font-size: 42px;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 8px;
        }

        .profession {
            font-size: 20px;
            color: #3498db;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .summary {
            margin-bottom: 20px;
            line-height: 1.7;
            color: #555;
            font-size: 14px;
        }

        .contact-info {
            margin-bottom: 30px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .contact-info > div {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
        }

        .contact-info a {
            color: #3498db;
            text-decoration: none;
        }

        h2 {
            font-size: 18px;
            font-weight: 700;
            color: #2c3e50;
            margin-top: 25px;
            margin-bottom: 15px;
            padding-bottom: 8px;
            border-bottom: 2px solid #3498db;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .education1,
        .certificate-container,
        .upper-column-employer1,
        .upper-column-employer2,
        .upper-column-employer3 {
            margin-bottom: 20px;
            page-break-inside: avoid;
        }

        .education1,
        .upper-column-employer1,
        .upper-column-employer2,
        .upper-column-employer3 {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .edu-column-1,
        .upper-column-1 {
            flex: 1;
        }

        .school,
        .title {
            font-size: 15px;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 4px;
        }

        .major,
        .company {
            font-size: 14px;
            color: #3498db;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .description {
            font-size: 12px;
            color: #777;
            font-style: italic;
        }

        .period,
        .location {
            font-size: 13px;
            color: #777;
            text-align: right;
            white-space: nowrap;
        }

        .lower-column ul {
            margin: 10px 0;
            padding-left: 25px;
        }

        .lower-column li {
            margin: 6px 0;
            font-size: 13px;
            color: #555;
            line-height: 1.6;
        }

        .certificate-name {
            font-size: 14px;
            font-weight: 600;
            color: #2c3e50;
            margin: 8px 0 4px 0;
        }

        .certificate-name a {
            color: #3498db;
            text-decoration: none;
        }

        .certificate-details {
            font-size: 12px;
            color: #666;
            line-height: 1.5;
            margin-bottom: 8px;
        }

        /* Right Container - Sidebar */
        .right-container {
            width: 35%;
            background: #3498db;
            color: white;
            padding: 50px 30px;
        }

        .right-container h2 {
            font-size: 16px;
            color: white;
            border-bottom: 2px solid rgba(255, 255, 255, 0.3);
            margin-top: 30px;
        }

        .right-container h2:first-child {
            margin-top: 0;
        }

        .skills-container ul,
        .projects-container {
            list-style: none;
            padding: 0;
        }

        .skills-container li,
        .projects-container h4 {
            margin: 8px 0;
            font-size: 13px;
            font-weight: 400;
        }

        .projects-container a {
            color: white;
            text-decoration: none;
            font-weight: 600;
        }

        .languages-container {
            margin: 15px 0;
        }

        .language-name {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .strengths-container {
            margin-top: 15px;
        }

        .strengths-container h4 {
            margin: 12px 0;
            font-size: 13px;
            font-weight: 400;
        }

        @media print {
            .big-container {
                background: white;
            }
        }
    </style>
</head>
<body>
    <div class="big-container">
        <div class="left-container">
            <header>
                <h1 class="name">{{personalInfo.fullName}}</h1>
                {{#if workExperiences.[0].position}}
                <p class="profession">{{workExperiences.[0].position}}</p>
                {{/if}}

                {{#if personalInfo.summary}}
                <div class="summary">
                    <p>{{personalInfo.summary}}</p>
                </div>
                {{/if}}

                {{#if hasProfessionalSummary}}
                <div class="summary">
                    <p>{{professionalSummary}}</p>
                </div>
                {{/if}}

                <div class="contact-info">
                    {{#if personalInfo.phone}}
                    <div class="phone-container">
                        <p class="phone-number">{{personalInfo.phone}}</p>
                    </div>
                    {{/if}}
                    {{#if personalInfo.email}}
                    <div class="email-container">
                        <p class="email"><a href="mailto:{{personalInfo.email}}">{{personalInfo.email}}</a></p>
                    </div>
                    {{/if}}
                    {{#if personalInfo.location}}
                    <div class="location-container">
                        <p class="city">{{personalInfo.location}}</p>
                    </div>
                    {{/if}}
                </div>
            </header>

            <div class="inner-columns">
                {{#if hasEducation}}
                <h2 class="education-heading">Education</h2>
                {{#each education}}
                <div class="education1">
                    <div class="edu-column-1">
                        <h4 class="school">{{this.institution}}</h4>
                        <h5 class="major">{{this.degreeField}}</h5>
                        {{#if this.gpa}}
                        <p class="description">GPA: {{this.gpa}}</p>
                        {{/if}}
                    </div>
                    <div class="edu-column-2">
                        <p class="period">{{this.duration}}</p>
                    </div>
                </div>
                {{/each}}
                {{/if}}

                {{#if hasCertifications}}
                <h2 class="certification">Certifications</h2>
                <div class="certification-container">
                    {{#each certifications}}
                    <div class="certificate-container">
                        <h4 class="certificate-name">{{this.name}}</h4>
                        {{#if this.issuingOrganization}}
                        <p class="certificate-details">{{this.issuingOrganization}}</p>
                        {{/if}}
                        {{#if this.duration}}
                        <p class="certificate-details">{{this.duration}}</p>
                        {{/if}}
                    </div>
                    {{/each}}
                </div>
                {{/if}}

                {{#if hasWorkExperience}}
                <h2>Experience</h2>
                {{#each workExperiences}}
                <div class="upper-column-employer{{@index}}">
                    <div class="upper-column-1">
                        <h4 class="title">{{this.position}}</h4>
                        <h4 class="company">{{this.companyName}}</h4>
                        {{#if this.location}}
                        <p class="description">{{this.location}}</p>
                        {{/if}}
                    </div>
                    <div class="upper-column-2">
                        <p class="period">{{this.duration}}</p>
                        {{#if this.location}}
                        <p class="location">{{this.location}}</p>
                        {{/if}}
                    </div>
                </div>
                {{#if this.description}}
                <div class="lower-column">
                    <p>{{this.description}}</p>
                </div>
                {{/if}}
                {{/each}}
                {{/if}}
            </div>
        </div>

        <div class="right-container">
            <!-- Profile Picture -->
            {{#if hasCVPicture}}
            <div style="text-align: center; margin-bottom: 30px;">
                <img src="{{cvPictureUrl}}" alt="Profile Picture" style="width: 150px; height: 150px; border-radius: 50%; object-fit: cover; border: 4px solid rgba(255, 255, 255, 0.3); box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);">
            </div>
            {{/if}}

            {{#if hasSkills}}
            <h2 class="skills">Skills</h2>
            <div class="skills-container">
                <ul>
                    {{#each skills}}
                    <li>{{this.name}}</li>
                    {{/each}}
                </ul>
            </div>
            {{/if}}

            {{#if hasLanguages}}
            <h2 class="languages">Languages</h2>
            <div class="languages">
                {{#each languages}}
                <div class="languages-container">
                    <h4 class="language-name">{{this.name}}:</h4>
                    <p>{{this.proficiency}}</p>
                </div>
                {{/each}}
            </div>
            {{/if}}

            {{#if personalInfo.linkedIn}}
            <h2>Links</h2>
            <div class="projects-container">
                <h4><a href="{{personalInfo.linkedIn}}" target="_blank">LinkedIn</a></h4>
                {{#if personalInfo.portfolio}}
                <h4><a href="{{personalInfo.portfolio}}" target="_blank">Portfolio</a></h4>
                {{/if}}
            </div>
            {{/if}}
        </div>
    </div>
</body>
</html>
