# Application
NODE_ENV=development
PORT=3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# WATI WhatsApp Configuration
WATI_API_ENDPOINT=https://live-server.wati.io
WATI_ACCESS_TOKEN=your-wati-access-token
WATI_WEBHOOK_SECRET=your-webhook-secret

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7

# Canva Configuration
CANVA_API_KEY=your-canva-api-key
CANVA_API_SECRET=your-canva-api-secret
CANVA_BASE_URL=https://api.canva.com/v1

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=cv-generator-files

# ElevenLabs Configuration (ASR & TTS)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# WhatsApp Cloud API (for PTT voice messages - bypasses WATI)
# Get these from Meta Business Suite -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-permanent-access-token

# Application Settings
MAX_FILE_SIZE_MB=10
SESSION_TIMEOUT_MINUTES=30
DEFAULT_LANGUAGE=en
